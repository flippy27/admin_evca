# ========================================
# WorkFoce Mobile App - QA Environment
# ========================================

# ========================================
# API Configuration
# ========================================
API_BASE_URL=https://emobility-bff.qa.dhemax.link/
API_TIMEOUT=30000
HTTP_LOG_LEVEL=2
HTTP_LOG_METHODS=ALL

# ========================================
# Authentication
# ========================================
AUTH_PROVIDER=keycloak
AUTH_REALM=evca-qa
AUTH_CLIENT_ID=admin-evca-mobile-qa
TOKEN_ENCRYPTION_KEY=your-32-char-encryption-key-here

# ========================================
# App Configuration
# ========================================
ENVIRONMENT=qa
APP_VERSION=2.0.0
DEBUG=true
ENABLE_MOCK_API=false
ENABLE_OFFLINE_SUPPORT=true

# ========================================
# Services
# ========================================
ANALYTICS_ENABLED=false
ANALYTICS_KEY=
SENTRY_ENABLED=true
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ========================================
# Localization
# ========================================
DEFAULT_LANGUAGE=es
DEFAULT_THEME=system

# ========================================
# EAS Build Configuration
# ========================================
APP_VARIANT=qa
APP_SLUG=workforceqa
APP_BUILD_NUMBER=1
BUNDLE_ID=com.dhemax.workforce-qa
EAS_PROJECT_ID=d156803f-09c8-4da1-81d7-a6e112c4c5bf
EAS_BUILD_CHANNEL=qa
