# ========================================
# WorkFoce Mobile App - Development Environment
# ========================================

# ========================================
# API Configuration
# ========================================
API_BASE_URL=https://emobility-bff.dev.dhemax.link/
API_TIMEOUT=30000
HTTP_LOG_LEVEL=2
HTTP_LOG_METHODS=COMMANDS
HTTP_LOG_SKIP_PATHS=charging-session/company

# ========================================
# Authentication
# ========================================
AUTH_PROVIDER=keycloak
AUTH_REALM=evca
AUTH_CLIENT_ID=admin-evca-mobile
TOKEN_ENCRYPTION_KEY=your-32-char-encryption-key-here

# ========================================
# App Configuration
# ========================================
ENVIRONMENT=development
APP_VERSION=6.0.0
DEBUG=true
ENABLE_MOCK_API=false
ENABLE_OFFLINE_SUPPORT=true

# ========================================
# Services
# ========================================
ANALYTICS_ENABLED=false
ANALYTICS_KEY=
SENTRY_ENABLED=false
SENTRY_DSN=

# ========================================
# Localization
# ========================================
DEFAULT_LANGUAGE=es
DEFAULT_THEME=system

# ========================================
# EAS Build Configuration
# ========================================
APP_VARIANT=development
APP_SLUG=workforcedev
APP_BUILD_NUMBER=1
BUNDLE_ID=com.dhemax.workforce-dev
EAS_PROJECT_ID=017aefff-040c-4065-9fc8-7668c9905974
EAS_BUILD_CHANNEL=development
